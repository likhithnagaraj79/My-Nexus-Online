# Template for a production build. Copy this to `.env.production.local` (already covered by
# the existing *.local gitignore rule, so it stays out of git) and fill in real values before
# running `npm run build` for a production deployment.

# The real, publicly reachable URL of the deployed backend — never localhost.
VITE_API_BASE_URL=https://api.yourdomain.example

# A REAL Google reCAPTCHA v2 site key for your domain. Do not reuse the test key committed in
# .env.example/.env.local (6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI) — it always passes
# validation and is only safe for local development, where the backend also has
# app.recaptcha.enabled=false. Production always has recaptcha.enabled=true (application-prod.yml).
VITE_RECAPTCHA_SITE_KEY=<your real Google reCAPTCHA v2 site key>
